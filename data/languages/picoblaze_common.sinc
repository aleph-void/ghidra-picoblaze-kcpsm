# Xilinx PicoBlaze (KCPSM3 and KCPSM6): spaces, registers and macros shared by both variants.
#
# Program memory is addressed in instructions: one address is one 18-bit instruction word, stored
# as 3 big-endian bytes (so the listing shows the same addresses as the PicoBlaze assembler's
# listing, and the interrupt vector of a 1K KCPSM3 is 0x3FF).

define endian=big;
define alignment=3;

define space rom            type=ram_space      size=2   wordsize=3 default;
# Scratchpad RAM: 64 bytes (KCPSM3), 64/128/256 bytes (KCPSM6, set by the implementation)
define space scratchpad     type=ram_space      size=1   wordsize=1;
# Call stack: one 12-bit return address per entry
define space stack_buffer   type=ram_space      size=1   wordsize=2;
# I/O ports: INPUT reads and OUTPUT writes separate spaces (8-bit port ids), as on the hardware
# where the two directions of a port id are different signals
define space port_in        type=ram_space      size=1   wordsize=1;
define space port_out       type=ram_space      size=1   wordsize=1;
define space register       type=register_space size=1;

define register offset=0x00 size=1 [ s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 sA sB sC sD sE sF ];
# KCPSM6 second register bank (the registers REGBANK B makes active; STAR writes them)
define register offset=0x10 size=1 [ s0_b s1_b s2_b s3_b s4_b s5_b s6_b s7_b s8_b s9_b sA_b sB_b sC_b sD_b sE_b sF_b ];
# Call stack pointer (entries), zero and carry flags, interrupt enable flip-flop, and the flags the
# interrupt logic saved when it took the interrupt (restored by RETURNI)
define register offset=0x20 size=1 [ SP Z C INT_ENABLE Z_SAVED C_SAVED ];
define register offset=0x30 size=2 [ PC ];
